# AgentTODO Docker Compose configuration
APP_TIMEZONE=Asia/Shanghai

# Optional. Leave blank only on a trusted local network.
# When set, browsers use HTTP Basic Auth (username below) and API clients may use
# Authorization: Bearer <token> or X-API-Token: <token>.
API_USERNAME=agenttodo
API_TOKEN=

# AgentTODO commonly pushes to a local AI service. Set false if webhooks should
# only reach public addresses. Optionally restrict to comma-separated exact
# hosts or wildcard subdomains, for example: localhost,192.168.1.20,*.example.com
WEBHOOK_ALLOW_PRIVATE_NETWORK=true
WEBHOOK_ALLOWED_HOSTS=
